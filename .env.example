# ─────────────────────────────────────────────────────────────
# Flat Portal — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Service-role key must stay server-side only.
# ─────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Service-role key — SERVER ONLY. Grants full DB access, bypasses RLS.
# Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public site URL (used for OAuth redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The two authorized administrators (comma-separated Gmail addresses).
# EXACTLY two. Used by the DB trigger + seed to grant the ADMIN role.
ADMIN_EMAILS="admin.one@gmail.com,admin.two@gmail.com"

# Shared secret protecting the scheduled overdue-task cron endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me-to-a-long-random-string"

# Optional — distributed rate limiting (Upstash Redis REST).
# If unset, an in-memory limiter is used (fine for a single instance / local dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
